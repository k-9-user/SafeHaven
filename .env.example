# =============================================================================
# SafeHaven — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# ANTHROPIC (Claude LLM — agent brain)
# Get your key at: https://console.anthropic.com/
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Model to use (default: claude-sonnet-4-6 for cost/quality balance)
ANTHROPIC_MODEL=claude-sonnet-4-6

# Maximum tokens per agent response (keep low for mobile data efficiency)
ANTHROPIC_MAX_TOKENS=1500

# -----------------------------------------------------------------------------
# ELEVENLABS (voice synthesis + STT)
# Get your key at: https://elevenlabs.io/app/settings/api-keys
# -----------------------------------------------------------------------------
ELEVENLABS_API_KEY=el_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Default voice IDs per language (find voices at elevenlabs.io/app/voice-library)
ELEVENLABS_VOICE_ID_EN=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_VOICE_ID_FR=TX3LPaxmHKxFdv7VOQHJ
ELEVENLABS_VOICE_ID_ES=VR6AewLTigWG4xSOukaG
ELEVENLABS_VOICE_ID_PT=pNInz6obpgDQGcFmaJgB
ELEVENLABS_VOICE_ID_SW=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_VOICE_ID_HA=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_VOICE_ID_AR=ErXwobaYiN019PkySvjV

# ElevenLabs TTS model (eleven_multilingual_v2 supports all 7 languages)
ELEVENLABS_MODEL=eleven_multilingual_v2

# -----------------------------------------------------------------------------
# SOLANA
# Public RPC endpoint — use a dedicated node in production (Helius, QuickNode, etc.)
# -----------------------------------------------------------------------------
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# For development/testing use devnet:
# SOLANA_RPC_URL=https://api.devnet.solana.com

# Solana cluster (mainnet-beta | devnet | testnet)
SOLANA_CLUSTER=mainnet-beta

# Helius API key (recommended — much higher rate limits than public RPC)
# Sign up at: https://helius.xyz
HELIUS_API_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# -----------------------------------------------------------------------------
# LI.FI (cross-chain bridging — Solana ecosystem partner)
# Docs: https://docs.li.fi/introduction/solana-ecosystem
# Get your key at: https://li.fi/sdk
# -----------------------------------------------------------------------------
LIFI_API_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Li.Fi integrator name (used for fee attribution in analytics)
LIFI_INTEGRATOR=safehaven

# -----------------------------------------------------------------------------
# VIRTUALS PROTOCOL (agent framework)
# Docs: https://docs.virtuals.io
# -----------------------------------------------------------------------------
VIRTUALS_API_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
VIRTUALS_AGENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# -----------------------------------------------------------------------------
# KAMINO FINANCE (USDC lending — primary conservative strategy)
# No API key required — interacts via Solana program directly
# Program IDs (mainnet):
# -----------------------------------------------------------------------------
KAMINO_LENDING_PROGRAM_ID=KLend2g3cP87fffoy8q1mQqGKjrL1AyGulgtnNXHsSH

# -----------------------------------------------------------------------------
# MARGINFI (USDC lending — secondary conservative strategy)
# No API key required — interacts via Solana program directly
# -----------------------------------------------------------------------------
MARGINFI_PROGRAM_ID=MFv2hWf31Z9kbCa1snEPdcgp7vGVw8Ly6SnGPGSJoX

# -----------------------------------------------------------------------------
# AGENT SERVICE
# -----------------------------------------------------------------------------

# Port for the agent HTTP server
AGENT_PORT=3001

# Environment (development | staging | production)
NODE_ENV=development

# JWT secret for signing user session tokens (generate with: openssl rand -base64 64)
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET_AT_LEAST_64_CHARS

# JWT expiry
JWT_EXPIRY=7d

# CORS — comma-separated allowed origins
CORS_ORIGINS=http://localhost:8081,exp://localhost:8081

# Rate limiting (requests per minute per IP)
RATE_LIMIT_RPM=60

# Rate limiting (requests per minute per authenticated user)
RATE_LIMIT_USER_RPM=20

# -----------------------------------------------------------------------------
# MOBILE APP (Expo — variables prefixed EXPO_PUBLIC_ are bundled in the app)
# NEVER put secret API keys in EXPO_PUBLIC_ variables.
# -----------------------------------------------------------------------------

# Agent backend URL (what the mobile app calls)
EXPO_PUBLIC_AGENT_URL=http://localhost:3001

# Solana RPC for read-only calls in the app (public endpoint — no secrets)
EXPO_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Solana cluster
EXPO_PUBLIC_SOLANA_CLUSTER=mainnet-beta

# Li.Fi API base URL
EXPO_PUBLIC_LIFI_API_URL=https://li.quest/v1

# Default app language (en | fr | es | pt | sw | ha | ar)
EXPO_PUBLIC_DEFAULT_LOCALE=en

# Feature flags
EXPO_PUBLIC_FEATURE_DEFI_ENABLED=true
EXPO_PUBLIC_FEATURE_BRIDGE_ENABLED=true
EXPO_PUBLIC_FEATURE_VOICE_ENABLED=true

# App environment label shown in UI during development
EXPO_PUBLIC_APP_ENV=development

# -----------------------------------------------------------------------------
# OPTIONAL: DATABASE (if you add user persistence)
# -----------------------------------------------------------------------------
# DATABASE_URL=postgresql://user:password@host:5432/safehaven

# -----------------------------------------------------------------------------
# OPTIONAL: SENTRY (error tracking)
# -----------------------------------------------------------------------------
# SENTRY_DSN=https://XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX@oXXXXXX.ingest.sentry.io/XXXXXXX
# EXPO_PUBLIC_SENTRY_DSN=https://XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX@oXXXXXX.ingest.sentry.io/XXXXXXX
