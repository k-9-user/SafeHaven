# =============================================================================
# SafeHaven - Environment Variables
# Copy this file to .env and fill in real values locally.
# NEVER commit .env or real API keys to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# AI
# -----------------------------------------------------------------------------
OPENAI_API_KEY=replace_with_openai_key
ANTHROPIC_API_KEY=replace_with_anthropic_key
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MAX_TOKENS=1500

# -----------------------------------------------------------------------------
# ELEVENLABS
# -----------------------------------------------------------------------------


# Default voice IDs per language.
ELEVENLABS_VOICE_ID_EN=replace_with_voice_id
ELEVENLABS_VOICE_ID_FR=replace_with_voice_id
ELEVENLABS_VOICE_ID_ES=replace_with_voice_id
ELEVENLABS_VOICE_ID_PT=replace_with_voice_id
ELEVENLABS_VOICE_ID_SW=replace_with_voice_id
ELEVENLABS_VOICE_ID_HA=replace_with_voice_id
ELEVENLABS_VOICE_ID_AR=replace_with_voice_id
ELEVENLABS_MODEL=eleven_multilingual_v2

# -----------------------------------------------------------------------------
# SOLANA
# -----------------------------------------------------------------------------
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_CLUSTER=devnet
HELIUS_API_KEY=replace_with_helius_key

# -----------------------------------------------------------------------------
# LI.FI
# -----------------------------------------------------------------------------
LIFI_API_KEY=replace_with_lifi_key
LIFI_INTEGRATOR=safehaven
VITE_WALLET_CONNECT_PROJECT_ID=replace_with_walletconnect_project_id

# -----------------------------------------------------------------------------
# VIRTUALS
# -----------------------------------------------------------------------------
VIRTUALS_API_KEY=replace_with_virtuals_key
VIRTUALS_AGENT_ID=replace_with_virtuals_agent_id

# -----------------------------------------------------------------------------
# DEFI PROGRAM IDS
# -----------------------------------------------------------------------------
KAMINO_LENDING_PROGRAM_ID=KLend2g3cP87fffoy8q1mQqGKjrL1AyGulgtnNXHsSH
MARGINFI_PROGRAM_ID=MFv2hWf31Z9kbCa1snEPdcgp7vGVw8Ly6SnGPGSJoX

# -----------------------------------------------------------------------------
# LOCAL SERVER
# -----------------------------------------------------------------------------
AGENT_PORT=3001
NODE_ENV=development
JWT_SECRET=replace_with_strong_random_secret
JWT_EXPIRY=7d
CORS_ORIGINS=http://localhost:8081,exp://localhost:8081
RATE_LIMIT_RPM=60
RATE_LIMIT_USER_RPM=20

# -----------------------------------------------------------------------------
# MOBILE APP PUBLIC VALUES
# -----------------------------------------------------------------------------
EXPO_PUBLIC_AGENT_URL=http://localhost:3001
EXPO_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
EXPO_PUBLIC_SOLANA_CLUSTER=devnet
EXPO_PUBLIC_LIFI_API_URL=https://li.quest/v1
EXPO_PUBLIC_DEFAULT_LOCALE=en
EXPO_PUBLIC_FEATURE_DEFI_ENABLED=true
EXPO_PUBLIC_FEATURE_BRIDGE_ENABLED=true
EXPO_PUBLIC_FEATURE_VOICE_ENABLED=true
EXPO_PUBLIC_APP_ENV=development

# -----------------------------------------------------------------------------
# OPTIONAL SERVICES
# -----------------------------------------------------------------------------
# DATABASE_URL=postgresql://user:password@host:5432/safehaven
# SENTRY_DSN=replace_with_sentry_dsn
# EXPO_PUBLIC_SENTRY_DSN=replace_with_public_sentry_dsn
