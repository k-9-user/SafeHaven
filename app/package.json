{
  "name": "safehaven-app",
  "version": "1.0.0",
  "description": "SafeHaven mobile app — AI financial guidance for LATAM, Africa & disability-first users",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:android": "eas build --platform android",
    "build:android:preview": "eas build --platform android --profile preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "test": "jest --watchAll=false",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "expo": "~52.0.46",
    "expo-router": "~4.0.20",
    "react": "18.3.1",
    "react-native": "0.76.9",

    "expo-status-bar": "~2.0.1",
    "expo-constants": "~17.0.8",
    "expo-splash-screen": "~0.29.22",
    "expo-font": "~13.0.4",
    "expo-localization": "~15.0.5",
    "expo-haptics": "~14.0.1",
    "expo-av": "~15.0.2",
    "expo-speech": "~13.1.0",
    "expo-file-system": "~18.0.12",
    "expo-secure-store": "~14.0.1",
    "expo-network": "~7.0.4",
    "expo-keep-awake": "~14.0.3",

    "@react-navigation/native": "^6.1.18",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/stack": "^6.4.1",
    "@react-navigation/native-stack": "^6.11.0",
    "react-native-screens": "~4.4.0",
    "react-native-safe-area-context": "4.12.0",
    "react-native-gesture-handler": "~2.22.0",
    "react-native-reanimated": "~3.16.7",

    "@solana/web3.js": "^1.98.0",
    "@solana-mobile/mobile-wallet-adapter-protocol": "^2.1.4",
    "@solana-mobile/mobile-wallet-adapter-protocol-web3js": "^2.1.4",
    "@solana-mobile/wallet-adapter-mobile": "^2.1.4",

    "@lifi/sdk": "^3.4.1",

    "i18next": "^23.16.8",
    "react-i18next": "^15.5.1",

    "zustand": "^5.0.5",
    "axios": "^1.8.4",
    "zod": "^3.24.2",

    "react-native-mmkv": "^3.2.0",

    "@shopify/flash-list": "^1.7.3",
    "react-native-svg": "^15.11.2",
    "react-native-progress": "^5.0.1",
    "lottie-react-native": "^7.2.2",

    "@react-native-async-storage/async-storage": "2.1.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~18.3.21",
    "@types/react-native": "~0.76.9",
    "typescript": "^5.8.3",
    "@typescript-eslint/eslint-plugin": "^8.26.0",
    "@typescript-eslint/parser": "^8.26.0",
    "eslint": "^9.22.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-native-a11y": "^3.3.0",
    "jest": "^29.7.0",
    "jest-expo": "~52.0.5",
    "@testing-library/react-native": "^12.9.0",
    "@testing-library/jest-native": "^5.4.3",
    "eas-cli": "^14.2.0"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterFramework": [
      "@testing-library/jest-native/extend-expect"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|lottie-react-native)"
    ]
  }
}
